      "name": "1. Joueur A — compte",
      "item": [
        {
          "name": "Inscription (A)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/inscription",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "inscription"
              ]
            },
            "description": "Crée le compte. Réponse 201 : { jeton, joueur }. Le jeton est enregistré dans la variable « jeton_a ». Erreur 422 si le pseudo est pris ou invalide (2 à 16 caractères ; mot de passe 6 caractères au moins). Limite : 10 essais par minute.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pseudo\": \"{{pseudo_a}}\",\n  \"mot_de_passe\": \"{{mot_de_passe_a}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut ' + pm.response.code, () => pm.expect(pm.response.code).to.be.below(500));",
                  "try { const j = pm.response.json(); if (j.jeton) pm.collectionVariables.set('jeton_a', j.jeton); } catch (e) {}"
                ]
              }
            }
          ]
        },
        {
